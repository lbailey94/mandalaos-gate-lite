{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "profile_id": "urn:mandala:runner-profile:gap-mesh-7369",
  "version": "1.0.0",
  "title": "Declarative Wire Protocol 7369 profile proposal (not executable)",
  "description": "Unimplemented policy proposal. Gate-Lite has no runner adapter or evidence enforcing this profile; selecting it for execution is unsupported and must fail closed.",
  "status": "declarative_only",
  "execution_enabled": false,
  "unsupported_reasons": [
    "No TCP destination/port mediation is implemented.",
    "No Ed25519 peer authentication is implemented.",
    "The existing Bubblewrap runner cannot enforce this network policy."
  ],
  "network_policy": {
    "mode": "restricted_p2p_mesh",
    "permitted_ports": [7369],
    "protocol": "rfc-7369-gap-junction",
    "transport": "tcp_nodelay",
    "dns_permitted": false,
    "cloud_egress_permitted": false,
    "raw_socket_permitted": false,
    "mutual_auth": "ed25519_dalek_dalek",
    "loopback_allowed": true,
    "wan_peer_pinning": "allowlist_only"
  },
  "filesystem_policy": {
    "root_ro": true,
    "workspace_mount": "/workspace",
    "workspace_rw": false,
    "tmpfs": "/tmp",
    "proc_ro": true,
    "dev_minimal": true
  },
  "environment": {
    "WM_SANDBOXED": "1",
    "WM_MESH_PROFILE": "gap-junction-7369",
    "WM_MESH_PORT": "7369",
    "WM_MESH_ALLOW_REMOTE": "1"
  },
  "provenance": {
    "status": "proposal; no runtime enforcement evidence",
    "standard": "Mandala Gate-Lite 0.5 candidate",
    "target_substrates": ["whitemagic-gen3", "mandalaos-sovereign"]
  }
}
